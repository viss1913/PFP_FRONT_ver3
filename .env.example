# Partner handoff: README.md + AGENTS.md + docs/PARTNER_*
# Clone: git clone --branch partner-handoff --single-branch …
# Handoff branch (read-only): partner-handoff

# Публичный URL сайта (canonical, Open Graph, sitemap при build)
VITE_SITE_URL=https://family-office.bank-future.com

# API (test / preview / Yandex build)
# VITE_API_BASE_URL=https://pfp-api.bank-future.com/api
# VITE_API_URL=https://pfp-api.bank-future.com

# Аналитика (reachGoal на лендинге; счётчик также в index.html)
VITE_YM_COUNTER_ID=109614082
VITE_GA_MEASUREMENT_ID=

# Webhook лидов с лендинга
VITE_LANDING_LEAD_WEBHOOK=

# Видео в блоке обучения (YouTube embed URL)
VITE_LANDING_VIDEO_URL=

# Картинки лендинга (один набор, без m/f)
VITE_LANDING_HERO_IMAGE=/landing/hero.webp
VITE_LANDING_EDUCATION_IMAGE=/landing/education.webp
VITE_LANDING_STATS_IMAGE=/landing/stats-illustration.webp

# Деплой в Yandex Object Storage (только для npm run upload:yandex / deploy:yandex, не VITE_)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# BUCKET_NAME=
# YC_S3_ENDPOINT=https://storage.yandexcloud.net
# YC_S3_PREFIX=

# Constructor site-chat виджеты (/rostech, /npf) — не AI B2C, не /plan
# ROSTECH_PROJECT_KEY=pk_...
# RENESSANS_PROJECT_KEY=pk_...
# ROSTECH_API_BASE_URL=https://pfp-api.bank-future.com
# RENESSANS_API_BASE_URL=https://pfp-api.bank-future.com
